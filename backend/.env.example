# Copie para .env e preencha. Nunca versione o .env.
# Os valores abaixo são apenas exemplos e são recusados na inicialização.

NODE_ENV=development
PORT=3001

# Senha do painel admin (mínimo 8 caracteres)
ADMIN_PASSWORD=troque-esta-senha
# Segredo de assinatura do JWT (mínimo 32 caracteres, diferente da senha).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
# Validade do token: número + s, m, h ou d (ex.: 30m, 8h, 1d)
JWT_EXPIRES_IN=8h

# Origens do frontend autorizadas no CORS, separadas por vírgula, sem barra no final.
# Desenvolvimento: http://localhost:3000. Produção: o domínio publicado do frontend.
CORS_ORIGINS=http://localhost:3000

# URL pública deste backend (usada para montar o endereço das imagens enviadas).
PUBLIC_BASE_URL=http://localhost:3001

# Pasta de dados: destinos.json, destinos.json.bak e uploads/.
# Em produção aponte para o DISCO PERSISTENTE (ex.: /var/data).
DATA_DIR=./data
# UPLOAD_DIR=./data/uploads

# Limite de tamanho por imagem, em MB (1 a 20)
MAX_UPLOAD_MB=5

# Dados iniciais usados SOMENTE quando destinos.json ainda não existe.
# Deixe vazio em produção para começar com a lista vazia.
SEED_FILE=./seed/destinos.json

# LOG_REQUESTS=true
